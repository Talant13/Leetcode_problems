with session_min as (
    select e.user_id,
           (max(e.event_timestamp) - min(e.event_timestamp)) * 24 * 60 as session_min
      from app_events e
    group by e.user_id
   having (max(e.event_timestamp) - min(e.event_timestamp)) * 24 * 60 > 30
)Select e.session_id,
        e.user_id,
        s.session_min as session_duration_minutes,
        sum(case when e.event_type = 'scroll' then 1 else 0 end) as scroll_count
        -- sum(case when e.event_type = 'click' then 1 else 0 end) as click_events,
        -- sum(case when e.event_type = 'app_open' then 1 else 0 end) as app_open_events,
        -- sum(case when e.event_type = 'purchase' then 1 else 0 end) as purchase_events,
        -- sum(case when e.event_type = 'app_close' then 1 else 0 end) as app_close_events,
        --round(sum(case when e.event_type = 'click' then 1 else 0 end)/sum(case when e.event_type = 'scroll' then 1 else 0 end),2) as click_to_scroll_ratio
   from app_events e
   join session_min s on s.user_id = e.user_id
   group by e.session_id,
            e.user_id,
            s.session_min
  having round(sum(case when e.event_type = 'click' then 1 else 0 end)/sum(case when e.event_type = 'scroll' then 1 else 0 end),2) < 0.20
    and sum(case when e.event_type = 'purchase' then 1 else 0 end) = 0
    and sum(case when e.event_type = 'scroll' then 1 else 0 end) >= 5
order by sum(case when e.event_type = 'scroll' then 1 else 0 end) desc,
         e.session_id asc
